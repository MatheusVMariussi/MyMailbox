{
  "name": "mymailbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:bundle && vp dev --port 3000",
    "build": "npm run db:bundle && vp build",
    "start": "vp preview --port 3000",
    "lint": "vp lint .",
    "deploy": "npm run build && npm run deploy:worker",
    "deploy:worker": "node scripts/strip-dev-vars.mjs && wrangler deploy",
    "deploy:local": "npm run deploy",
    "upload": "npm run build && node scripts/strip-dev-vars.mjs && wrangler versions upload",
    "preview": "npm run build && vp preview --port 3000",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "db:bundle": "node scripts/generate-migration-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "migrate": "wrangler d1 migrations apply DB",
    "db:seed": "curl -X POST http://localhost:3000/api/seed",
    "test:e2e": "playwright test"
  },
  "cloudflare": {
    "bindings": {
      "CF_TOKEN": {
        "description": "Runtime Cloudflare API token used by MyMailbox onboarding to call the Zones, DNS, and Email Routing APIs. Cloudflare's deploy/build token is not passed to the app, so create this separately at https://dash.cloudflare.com/profile/api-tokens with `Zone Read`, `DNS Edit`, `Email Routing Edit`, and `Email Routing Rules Write` permissions for the zones you will connect. Add `Email Sending Edit` to enable outbound mail. Paste only the token secret value, without `Bearer`."
      },
      "SETUP_TOKEN": {
        "description": "Secret you enter on /setup before MyMailbox creates the first admin account and provisions DNS with CF_TOKEN. Use a long random value (for example `openssl rand -base64 32`). Setup is refused while it is unset, except on localhost."
      },
      "TURNSTILE_SECRET_KEY": {
        "description": "Cloudflare Turnstile secret key used to verify login and first-run registration challenges. Pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY at build time."
      },
      "NEXT_PUBLIC_TURNSTILE_SITE_KEY": {
        "description": "Cloudflare Turnstile public site key used by the login and first-run registration widgets."
      },
      "CF_EMAIL_WORKER_NAME": {
        "description": "Worker name used when creating Cloudflare Email Routing rules. Set this to the deployed Worker name; if you rename the Worker, update this value too."
      },
      "CF_EMAIL": {
        "description": "Legacy Global API Key auth only. Use this with `CF_API_KEY` instead of `CF_TOKEN`."
      },
      "CF_API_KEY": {
        "description": "Legacy Global API Key auth only. Prefer `CF_TOKEN` for new deployments."
      }
    }
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.100.11",
    "@vinext/cloudflare": "1.0.0-beta.11",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.2",
    "mimetext": "^3.0.28",
    "nanoid": "^5.1.16",
    "next": "16.4.6",
    "parse-srcset": "^1.0.2",
    "parse5": "^8.0.1",
    "postal-mime": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwind-merge": "^3.6.0",
    "tldts": "^7.4.16",
    "vinext": "1.0.0-beta.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5.7.4",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "better-sqlite3@13.0.3": true,
    "workerd@1.20260926.1": true
  }
}
