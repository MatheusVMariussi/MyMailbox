{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mymailbox",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	// Variables set in the dashboard (or by an earlier deploy) survive deploys that do not list them.
	"keep_vars": true,
	// This installation's custom domain, APP_URL (passkeys, reset links, download links) and VAPID_SUBJECT are
	// not versioned: they live in wrangler.install.json (gitignored; start from wrangler.install.example.json),
	// which `npm run deploy` lays over the generated deploy config (scripts/apply-install-config.mjs).
	"vars": {
		// Web Push: the public half of the VAPID pair (the private half is the VAPID_PRIVATE_KEY secret).
		"VAPID_PUBLIC_KEY": "BHIEoStcVqFXb0U7l0E0DayQpubWwA2vO3gJEI9r_R-dzOsQJ7w7l6nbPO5490UkU-rYPRj44XMCUPc407NIGgs",
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mymailbox",
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "DEVICE_LOGIN_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mymailbox",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mymailbox-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mymailbox-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mymailbox-outbound",
			},
		],
		"consumers": [
			{
				"queue": "mymailbox-inbound",
				"max_batch_size": 5,
				// New mail should reach the inbox at once; do not wait up to 5 s for a batch to fill.
				"max_batch_timeout": 1,
				// Mail waits out a database that is behind the code (300 s per retry, about an hour); see docs/deployment.md.
				"max_retries": 12,
			},
			{
				"queue": "mymailbox-outbound",
				"max_batch_size": 5,
				// Sends wait out the undo window already; do not also wait for a batch to fill.
				"max_batch_timeout": 1,
				"max_retries": 3,
			},
		],
	},
}
