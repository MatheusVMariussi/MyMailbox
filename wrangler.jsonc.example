{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mymailbox",
	"main": "./worker.ts",
	"compatibility_date": "2026-05-20",
	// Secrets are not configured here. Set them with `npx wrangler secret put <NAME>`:
	//   CF_TOKEN      runtime Cloudflare API token (DNS, Email Routing, and the account-level
	//                 "Email Sending: Edit" permission for outbound mail)
	//   SETUP_TOKEN   required by /setup until the first admin exists; setup is refused without it
	//                 (except on localhost). Use a long random value, e.g. `openssl rand -base64 32`.
	// Local development reads them from .dev.vars (see .dev.vars.example), which is never deployed.
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "none",
	},
	"images": {
		"binding": "IMAGES",
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "mymailbox",
		},
	],
	// Realtime updates: one RealtimeHub per user (worker.ts routes /api/realtime to it). The class must stay
	// exported from worker.ts, and the migration tag that created it must never be removed.
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME",
				"class_name": "RealtimeHub",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub",
			],
		},
	],
	"triggers": {
		"crons": ["0 2 * * *", "*/5 * * * *"],
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60,
			},
		},
		{
			"name": "DEVICE_LOGIN_RATE_LIMIT",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 },
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true,
		},
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mymailbox",
			"migrations_dir": "drizzle/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "mymailbox-raw",
		},
	],
	"queues": {
		"producers": [
			{
				"binding": "INBOUND_QUEUE",
				"queue": "mymailbox-inbound",
			},
			{
				"binding": "OUTBOUND_QUEUE",
				"queue": "mymailbox-outbound",
			},
		],
		"consumers": [
			{
				"queue": "mymailbox-inbound",
				"max_batch_size": 5,
				// New mail should reach the inbox at once; do not wait up to 5 s for a batch to fill.
				"max_batch_timeout": 1,
				// Mail waits out a database that is behind the code (300 s per retry, about an hour); see docs/deployment.md.
				"max_retries": 12,
			},
			{
				"queue": "mymailbox-outbound",
				"max_batch_size": 5,
				"max_retries": 3,
			},
		],
	},
}
